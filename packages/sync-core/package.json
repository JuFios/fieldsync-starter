{
  "name": "@fieldsync/sync-core",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "showSeed": true,
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@fieldsync/test-kit$": "<rootDir>/../test-kit/src"
    },
    "reporters": [
      "default",
      [
        "@fieldsync/test-kit/dist/reporter",
        {
          "label": "sync-core"
        }
      ]
    ]
  },
  "devDependencies": {
    "@fast-check/jest": "^3.0.0",
    "@fieldsync/test-kit": "*",
    "@types/eslint": "^8.56.12",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.11.0"
  },
  "dependencies": {
    "eventsource-parser": "^3.1.1",
    "idb": "^8.0.4"
  }
}
