{
  "name": "@fieldsync/sync-core",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@fieldsync/test-kit$": "<rootDir>/../test-kit/src"
    },
    "reporters": [
      "default",
      [
        "@fieldsync/test-kit/dist/reporter",
        {
          "label": "sync-core"
        }
      ]
    ]
  },
  "devDependencies": {
    "@fieldsync/test-kit": "*"
  }
}
