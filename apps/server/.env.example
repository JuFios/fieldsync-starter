# Server settings. For local development copy this file to apps/server/.env; the server reads it
# on startup. Variables set in the environment take precedence over the file. Invalid values stop
# the server with a list of problems.

# HTTP port of the API (1-65535).
PORT=3001
# Postgres connection string (secret: never logged). Matches `docker compose up -d postgres`.
DATABASE_URL=postgres://fieldsync:fieldsync@localhost:5432/fieldsync
# Maximum connections in the server's database pool (1-1000).
DB_POOL_MAX=20
# "true" inserts demo sites, users and well-known tokens on startup. Development only.
SEED_DEMO=true
# Timeouts of the server's database connections, in milliseconds. A writer waits at most
# DB_LOCK_TIMEOUT_MS for a lock (then 503 and the client retries); a statement runs at most
# DB_STATEMENT_TIMEOUT_MS; a server session idle inside a transaction is ended after
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS, which frees its locks.
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
# Change-log entries older than this many seconds are deleted by the GC (>= 1).
CHANGELOG_RETENTION_SECONDS=604800
# How often the change-log GC runs, in milliseconds (1000-2147483647).
GC_INTERVAL_MS=3600000
# Largest JSON request body in bytes (1048576-67108864); at least the 1 MiB a client puts in one push.
JSON_BODY_LIMIT_BYTES=2097152
# "true" serves the OpenAPI description at /docs-json and Swagger UI at /docs (no token needed).
API_DOCS_ENABLED=false
