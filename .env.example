# Settings for docker compose (copy to .env in the repository root). Every value has a default.
# Server settings for running outside Docker live in apps/server/.env.example.

# Postgres credentials and database (also used to build DATABASE_URL for migrate and server).
POSTGRES_USER=fieldsync
POSTGRES_PASSWORD=fieldsync
POSTGRES_DB=fieldsync
# Host address and ports the services are published on. 127.0.0.1 keeps them off the network; use
# 0.0.0.0 only with your own passwords and SEED_DEMO=false.
BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
SERVER_PORT=3001
WEB_PORT=3000
# "true" inserts demo sites, users and well-known tokens. Development only.
SEED_DEMO=true
# API URL as seen from the browser; compiled into the web bundle at build time. Defaults to
# http://localhost:${SERVER_PORT}; set it when the browser reaches the API under another address.
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Test settings (export them in your shell; tests do not read this file).
# Maintenance database for integration and e2e tests; tests create their own databases next to it.
# DATABASE_URL=postgres://fieldsync:fieldsync@localhost:5432/fieldsync
# "1" makes the integration tests fail instead of skipping when DATABASE_URL is missing (CI sets it).
# REQUIRE_DB=1
# Database the e2e run recreates and migrates; the name must end with _e2e.
# E2E_DATABASE=fieldsync_e2e
# Port of the web app during e2e (the API port comes from NEXT_PUBLIC_API_URL).
# E2E_WEB_PORT=3000
